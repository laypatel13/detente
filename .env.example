# `make setup` writes .env for you. These are the settings it holds.

# Switch's agent API, not its Gateway.
SWITCH_URL=http://localhost:8000
DETENTE_AGENT_ID=
DETENTE_API_KEY=
DETENTE_ROOM_ID=

# Each laptop sends this to /squawk and /clearance. Keep it secret.
DETENTE_PILOT_TOKEN=

# Optional. Default shown.
# DETENTE_DB=detente.db
